[debug] [2026-10-07T20:02:03.830Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-es-chat:securityRules [none]
[debug] [2026-10-07T20:02:03.830Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-es-chat:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{db}/documents {\n\n    function signedIn() { return request.auth != null; }\n    function isOwner() {\n      return signedIn()\n        && request.auth.token.email == 'moreand458@gmail.com'\n        && request.auth.token.email_verified == true;\n    }\n    function notBanned() {\n      return !(exists(/databases/$(db)/documents/users/$(request.auth.uid))\n        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('banned', false) == true);\n    }\n    function siteFlag(k) {\n      return !exists(/databases/$(db)/documents/settings/site)\n        || get(/databases/$(db)/documents/settings/site).data.get(k, true) != false;\n    }\n    function validProfile(d) {\n      return d.get('name', 'x').size() >= 1 && d.get('name', 'x').size() <= 40\n        && d.get('bio', '').size() <= 160\n        && d.get('photo', '').size() < 150000\n        && d.get('gender', 'male') in ['male', 'female'];\n    }\n\n    // ---------- المستخدمون ----------\n    match /users/{uid} {\n      allow get: if signedIn() && (request.auth.uid == uid || isOwner());\n      allow list: if isOwner();\n      allow create: if isOwner() && request.auth.uid == uid\n        || (signedIn() && request.auth.uid == uid && siteFlag('registrationOpen')\n            && request.resource.data.keys().hasOnly(['uid','name','createdAt','lastLogin','loginCount','onboarded'])\n            && validProfile(request.resource.data));\n      allow update: if isOwner()\n        || (signedIn() && request.auth.uid == uid\n            && request.resource.data.diff(resource.data).affectedKeys()\n                 .hasOnly(['name','photo','gender','bio','username','lastLogin','loginCount','onboarded','lastSeen','hideLastSeen','readReceipts','noAdd'])\n            && (!('username' in request.resource.data.diff(resource.data).affectedKeys())\n                || resource.data.get('username', '') == '')\n            && validProfile(request.resource.data));\n      allow delete: if isOwner();\n    }\n\n    match /users/{uid}/public/{d} {\n      allow get: if signedIn();\n      allow list: if isOwner();\n      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner())\n        && request.resource.data.keys().hasOnly(['uid','name','photo','gender','bio','username','hideLastSeen','lastSeen','verified'])\n        && request.resource.data.uid == uid && validProfile(request.resource.data);\n      allow delete: if signedIn() && request.auth.uid == uid;\n    }\n\n    match /users/{uid}/private/{d} {\n      allow read, write: if signedIn() && (request.auth.uid == uid || isOwner());\n    }\n\n    match /users/{uid}/data/{d} {\n      allow read, write: if signedIn() && request.auth.uid == uid;\n    }\n\n    match /users/{uid}/tokens/{t} {\n      allow read, write: if signedIn() && request.auth.uid == uid;\n    }\n\n    // مفاتيح عامة للمرحلة الأولى من التشفير: لا يوجد أي private key هنا.\n    match /users/{uid}/crypto/{deviceId} {\n      allow get, list: if signedIn();\n      allow create, update: if signedIn() && request.auth.uid == uid\n        && request.resource.data.keys().hasOnly(['deviceId','identityDHPublic','identitySignPublic','signedPreKeyPublic','signedPreKeySignature','preKeysPublic','protocol'])\n        && request.resource.data.deviceId == deviceId\n        && request.resource.data.preKeysPublic is list\n        && request.resource.data.preKeysPublic.size() <= 100\n        && request.resource.data.protocol == 'e2ee-foundation-p256-v1';\n      allow delete: if signedIn() && request.auth.uid == uid;\n    }\n\n    match /settings/{d} {\n      allow read: if signedIn();\n      allow write: if isOwner();\n    }\n\n    // ---------- أسماء المستخدمين (فريدة) ----------\n    match /usernames/{u} {\n      allow get: if signedIn();\n      allow list: if isOwner();\n      allow create: if signedIn()\n        && u.matches('^[a-z0-9_]{3,20}$')\n        && request.resource.data.keys().hasOnly(['uid'])\n        && request.resource.data.uid == request.auth.uid;\n      allow delete: if isOwner();\n    }\n\n    // ---------- المحادثات (public = الغرفة العامة، والخاصة id = uid1_uid2) ----------\n    match /chats/{chatId} {\n      function inId() { return signedIn() && (chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid); }\n      allow get: if inId();\n      allow list: if signedIn() && request.auth.uid in resource.data.members;\n      allow create: if inId() && notBanned()\n        && request.resource.data.keys().hasOnly(['members','lastText','lastAt','lastUid','typing','read','ttl'])\n        && request.resource.data.members.size() == 2\n        && request.auth.uid in request.resource.data.members\n        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];\n      allow update: if inId() && notBanned()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','lastAt','lastUid','typing','read','ttl','pin','pins'])\n        && request.resource.data.get('pins', []).size() <= 3;\n    }\n\n    match /chats/{chatId}/messages/{m} {\n      function inChat() { return chatId == 'public' || chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid; }\n      allow read: if signedIn() && inChat();\n      allow create: if signedIn() && notBanned() && inChat() && (chatId != 'public' || isOwner() || siteFlag('publicOpen'))\n        && (chatId == 'public' || (('cipher' in request.resource.data) && !('loc' in request.resource.data) && !('poll' in request.resource.data) && !('text' in request.resource.data) && !('img' in request.resource.data) && !('file' in request.resource.data)))\n        && request.resource.data.keys().hasOnly(['uid','text','at','reply','exp