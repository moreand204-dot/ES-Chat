[debug] [2026-10-07T20:02:08.649Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-es-chat:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{db}/documents {\n\n    function signedIn() { return request.auth != null; }\n    function isOwner() {\n      return signedIn()\n        && request.auth.token.email == 'moreand458@gmail.com'\n        && request.auth.token.email_verified == true;\n    }\n    function notBanned() {\n      return !(exists(/databases/$(db)/documents/users/$(request.auth.uid))\n        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('banned', false) == true);\n    }\n    function siteFlag(k) {\n      return !exists(/databases/$(db)/documents/settings/site)\n        || get(/databases/$(db)/documents/settings/site).data.get(k, true) != false;\n    }\n    function validProfile(d) {\n      return d.get('name', 'x').size() >= 1 && d.get('name', 'x').size() <= 40\n        && d.get('bio', '').size() <= 160\n        && d.get('photo', '').size() < 150000\n        && d.get('gender', 'male') in ['male', 'female'];\n    }\n\n    // ---------- المستخدمون ----------\n    match /users/{uid} {\n      allow get: if signedIn() && (request.auth.uid == uid || isOwner());\n      allow list: if isOwner();\n      allow create: if isOwner() && request.auth.uid == uid\n        || (signedIn() && request.auth.uid == uid && siteFlag('registrationOpen')\n            && request.resource.data.keys().hasOnly(['uid','name','createdAt','lastLogin','loginCount','onboarded'])\n            && validProfile(request.resource.data));\n      allow update: if isOwner()\n        || (signedIn() && request.auth.uid == uid\n            && request.resource.data.diff(resource.data).affectedKeys()\n                 .hasOnly(['name','photo','gender','bio','username','lastLogin','loginCount','onboarded','lastSeen','hideLastSeen','readReceipts','noAdd'])\n            && (!('username' in request.resource.data.diff(resource.data).affectedKeys())\n                || resource.data.get('username', '') == '')\n            && validProfile(request.resource.data));\n      allow delete: if isOwner();\n    }\n\n    match /users/{uid}/public/{d} {\n      allow get: if signedIn();\n      allow list: if isOwner();\n      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner())\n        && request.resource.data.keys().hasOnly(['uid','name','photo','gender','bio','username','hideLastSeen','lastSeen','verified'])\n        && request.resource.data.uid == uid && validProfile(request.resource.data);\n      allow delete: if signedIn() && request.auth.uid == uid;\n    }\n\n    match /users/{uid}/private/{d} {\n      allow read, write: if signedIn() && (request.auth.uid == uid || isOwner());\n    }\n\n    match /users/{uid}/data/{d} {\n      allow read, write: if signedIn() && request.auth.uid == uid;\n    }\n\n    match /users/{uid}/tokens/{t} {\n      allow read, write: if signedIn() && request.auth.uid == uid;\n    }\n\n    // مفاتيح عامة للمرحلة الأولى من التشفير: لا يوجد أي private key هنا.\n    match /users/{uid}/crypto/{deviceId} {\n      allow get, list: if signedIn();\n      allow create, update: if signedIn() && request.auth.uid == uid\n        && request.resource.data.keys().hasOnly(['deviceId','identityDHPublic','identitySignPublic','signedPreKeyPublic','signedPreKeySignature','preKeysPublic','protocol'])\n        && request.resource.data.deviceId == deviceId\n        && request.resource.data.preKeysPublic is list\n        && request.resource.data.preKeysPublic.size() <= 100\n        && request.resource.data.protocol == 'e2ee-foundation-p256-v1';\n      allow delete: if signedIn() && request.auth.uid == uid;\n    }\n\n    match /settings/{d} {\n      allow read: if signedIn();\n      allow write: if isOwner();\n    }\n\n    // ---------- أسماء المستخدمين (فريدة) ----------\n    match /usernames/{u} {\n      allow get: if signedIn();\n      allow list: if isOwner();\n      allow create: if signedIn()\n        && u.matches('^[a-z0-9_]{3,20}$')\n        && request.resource.data.keys().hasOnly(['uid'])\n        && request.resource.data.uid == request.auth.uid;\n      allow delete: if isOwner();\n    }\n\n    // ---------- المحادثات (public = الغرفة العامة، والخاصة id = uid1_uid2) ----------\n    match /chats/{chatId} {\n      function inId() { return signedIn() && (chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid); }\n      allow get: if inId();\n      allow list: if signedIn() && request.auth.uid in resource.data.members;\n      allow create: if inId() && notBanned()\n        && request.resource.data.keys().hasOnly(['members','lastText','lastAt','lastUid','typing','read','ttl'])\n        && request.resource.data.members.size() == 2\n        && request.auth.uid in request.resource.data.members\n        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];\n      allow update: if inId() && notBanned()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','lastAt','lastUid','typing','read','ttl','pin','pins'])\n        && request.resource.data.get('pins', []).size() <= 3;\n    }\n\n    match /chats/{chatId}/messages/{m} {\n      function inChat() { return chatId == 'public' || chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid; }\n      allow read: if signedIn() && inChat();\n      allow create: if signedIn() && notBanned() && inChat() && (chatId != 'public' || isOwner() || siteFlag('publicOpen'))\n        && (chatId == 'public' || (('cipher' in request.resource.data) && !('loc' in request.resource.data) && !('poll' in request.resource.data) && !('text' in request.resource.data) && !('img' in request.resource.data) && !('file' in request.resource.data)))\n        && request.resource.data.keys().hasOnly(['uid','text','at','reply','exp','img','loc','fwd','poll','cipher'])\n        && (chatId == 'public' || request.resource.data.keys().hasOnly(['uid','at','exp','cipher']))\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.get('text', '') is string\n        && request.resource.data.get('text', '').size() <= 2000\n        && (request.resource.data.get('text', '').size() > 0 || 'img' in request.resource.data || 'loc' in request.resource.data || 'poll' in request.resource.data\n            || ('cipher' in request.resource.data\n              && request.resource.data.cipher.v == 2\n              && request.resource.data.cipher.alg == 'ECDH-P256-AESGCM-DUAL'\n              && request.resource.data.cipher.keys().hasOnly(['v','alg','recipient','sender'])\n              && request.resource.data.cipher.recipient.keys().hasOnly(['senderEphemeralPublic','iv','ciphertext'])\n              && request.resource.data.cipher.sender.keys().hasOnly(['senderIdentityPublic','iv','ciphertext'])\n              && request.resource.data.cipher.recipient.iv is string && request.resource.data.cipher.recipient.iv.size() == 16\n              && request.resource.data.cipher.sender.iv is string && request.resource.data.cipher.sender.iv.size() == 16\n              && request.resource.data.cipher.recipient.ciphertext is string && request.resource.data.cipher.recipient.ciphertext.size() <= 600000\n              && request.resource.data.cipher.sender.ciphertext is string && request.resource.data.cipher.sender.ciphertext.size() <= 600000))\n        && (!('poll' in request.resource.data) || (request.resource.data.poll.keys().hasOnly(['q','o'])\n              && request.resource.data.poll.q is string && request.resource.data.poll.q.size() >= 1 && request.resource.data.poll.q.size() <= 200\n              && request.resource.data.poll.o is list && request.resource.data.poll.o.size() >= 2 && request.resource.data.poll.o.size() <= 12))\n        && request.resource.data.get('img', '').size() < 400000;\n      allow update: if (signedIn() && resource.data.uid == request.auth.uid\n        && (chatId == 'public' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']))\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','text','img','loc','reply'])\n        && request.resource.data.get('deleted', false) == true)\n        // تعديل منشور خاص: صاحبه فقط\n        || (signedIn() && chatId != 'public' && resource.data.uid == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cipher'])\n          && request.resource.data.cipher.keys().hasOnly(['v','alg','recipient','sender'])\n          && request.resource.data.cipher.v == 2\n          && request.resource.data.cipher.alg == 'ECDH-P256-AESGCM-DUAL')\n        || (signedIn() && chatId == 'public' && resource.data.uid == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])\n          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)\n        // تفاعل بإيموجي: كل مستخدم يعدّل خانته فقط، والقراءة محصورة بأطراف المحادثة\n        || (signedIn() && chatId == 'public' && inChat()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])\n          && request.resource.data.reactions is map\n          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))\n        || (signedIn() && chatId != 'public' && inChat()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCiphers'])\n          && request.resource.data.reactionCiphers is map\n          && request.resource.data.reactionCiphers.diff(resource.data.get('reactionCiphers', {})).affectedKeys().hasOnly([request.auth.uid])\n          && (!(request.auth.uid in request.resource.data.reactionCiphers)\n              || (request.resource.data.reactionCiphers[request.auth.uid].keys().hasOnly(['v','alg','senderIdentityPublic','iv','ciphertext'])\n                && request.resource.data.reactionCiphers[request.auth.uid].alg == 'ECDH-P256-AESGCM-SHARED'\n                && request.resource.data.reactionCiphers[request.auth.uid].ciphertext is string\n                && request.resource.data.reactionCiphers[request.auth.uid].ciphertext.size() <= 20000)))\n        // تصويت في استفتاء: المشارك يعدّل صوته هو بس\n        || (signedIn() && inChat() && 'poll' in resource.data\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])\n          && request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid])\n          && (!(request.auth.uid in request.resource.data.votes)\n              || (request.resource.data.votes[request.auth.uid] is int\n                  && request.resource.data.votes[request.auth.uid] >= 0\n                  && request.resource.data.votes[request.auth.uid] < resource.data.poll.o.size())));\n      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || (isOwner() && chatId == 'public'));\n    }\n\n    // ---------- المجموعات والقنوات ----------\n    function gm(g) { return request.auth.uid in g.members; }\n    function gAdmin(g) { return gm(g) && (request.auth.uid == g.owner || request.auth.uid in g.admins); }\n    function gMax(g) { return g.kind == 'channel' ? 5000 : 256; }\n    function secretP(gid) { return /databases/$(db)/documents/groups/$(gid)/secret/invite; }\n    function invitedP(gid, u) { return /databases/$(db)/documents/groups/$(gid)/invites/$(u); }\n    // رابط الدعوة: القناة العامة مفتوحة، وغير كده لو فيه مفتاح مسجّل لازم العضو الجديد يكون كتب نفس المفتاح في نفس العملية\n    function inviteOk(gid, g) {\n      return g.get('public', false) == true || !exists(secretP(gid))\n        || getAfter(invitedP(gid, request.auth.uid)).data.k == get(secretP(gid)).data.key;\n    }\n\n    match /groups/{gid} {\n      // مستند المجموعة الكامل لا يُقرأ إلا بواسطة عضو؛ دليل القنوات العام منفصل أسفل القاعدة.\n      allow get, list: if signedIn() && request.auth.uid in resource.data.members;\n      allow create: if signedIn() && notBanned()\n        && request.resource.data.owner == request.auth.uid\n        && request.resource.data.keys().hasOnly(['kind','name','desc','photo','owner','admins','members','public','joinOpen','handle','createdAt','lastText','lastAt','lastUid','lastName'])\n        && request.resource.data.kind in ['group','channel']\n        && request.resource.data.name is string\n        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 50\n        && request.resource.data.get('desc', '').size() <= (request.resource.data.kind == 'channel' ? 512 : 200)\n        && request.resource.data.get('photo', '').size() < 150000\n        && request.resource.data.admins == [request.auth.uid]\n        && request.auth.uid in request.resource.data.members\n        && request.resource.data.members.size() <= 60;\n      allow update: if signedIn() && notBanned() && (\n        // 1) المشرفين: تعديل البيانات وإضافة/إزالة الأعضاء\n        (gAdmin(resource.data)\n          && request.resource.data.owner == resource.data.owner\n          && request.resource.data.kind == resource.data.kind\n          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 50\n          && request.resource.data.get('desc', '').size() <= (resource.data.kind == 'channel' ? 512 : 200)\n          && request.resource.data.get('photo', '').size() < 150000\n          && resource.data.owner in request.resource.data.members\n          && request.resource.data.members.size() <= gMax(resource.data)\n          && (request.resource.data.admins == resource.data.admins || request.auth.uid == resource.data.owner)\n          && request.resource.data.get('pins', []).size() <= 3\n          // مفتاح handle مش موجود في اللستة دي، يعني ثابت بعد الإنشاء ومينفعش يتغيّر من هنا (كان ينفع يتسرق handle مجموعة تانية)\n          && request.resource.data.diff(resource.data).affectedKeys()\n               .hasOnly(['name','desc','photo','public','joinOpen','approve','noReact','sendAdmins','verified','members','admins','banned','muted','pin','pins'])\n          && (request.resource.data.get('verified', false) == resource.data.get('verified', false) || request.auth.uid == resource.data.owner))\n        // 2) انضمام / متابعة بالرابط\n        || (resource.data.joinOpen == true && resource.data.get('approve', false) == false && !(request.auth.uid in resource.data.members) && !(request.auth.uid in resource.data.get('banned', [])) && inviteOk(gid, resource.data)\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])\n          && request.auth.uid in request.resource.data.members\n          && request.resource.data.members.hasAll(resource.data.members)\n          && request.resource.data.members.size() == resource.data.members.size() + 1\n          && request.resource.data.members.size() <= gMax(resource.data))\n        // 3) مغادرة\n        || (gm(resource.data) && request.auth.uid != resource.data.owner\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins'])\n          && !(request.auth.uid in request.resource.data.members)\n          && !(request.auth.uid in request.resource.data.admins)\n          && request.resource.data.members.hasOnly(resource.data.members)\n          && request.resource.data.members.size() == resource.data.members.size() - 1)\n        // 3.5) المالك بيخرج وبينقل الملكية لعضو\n        || (request.auth.uid == resource.data.owner\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner','members','admins'])\n          && request.resource.data.owner != request.auth.uid\n          && request.resource.data.owner in resource.data.members\n          && request.resource.data.owner in request.resource.data.admins\n          && !(request.auth.uid in request.resource.data.members)\n          && !(request.auth.uid in request.resource.data.admins)\n          && request.resource.data.members.hasOnly(resource.data.members)\n          && request.resource.data.members.size() == resource.data.members.size() - 1)\n        // 3.7) قبول دعوة مشرف (التوكن لازم يكون موجود، وبيتمسح في نفس العملية فمينفعش يتستخدم مرتين)\n        || (gm(resource.data)\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins'])\n          && request.auth.uid in request.resource.data.admins\n          && request.resource.data.admins.hasAll(resource.data.admins)\n          && request.resource.data.admins.size() == resource.data.admins.size() + 1\n          && (resource.data.kind == 'group' || request.resource.data.admins.size() <= 16)\n          && exists(/databases/$(db)/documents/groups/$(gid)/adminInvites/$(getAfter(/databases/$(db)/documents/groups/$(gid)/adminAccepts/$(request.auth.uid)).data.t)))\n        // 4) تحديث آخر رسالة (الأعضاء في المجموعات، والمشرفين في القنوات)\n        || (gm(resource.data)\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','lastAt','lastUid','lastName'])\n          && ((resource.data.kind == 'group' && resource.data.get('sendAdmins', false) == false) || gAdmin(resource.data)))\n      );\n      allow delete: if signedIn() && request.auth.uid == resource.data.owner;\n    }\n\n    // دليل القنوات العامة فقط؛ لا يحتوي members أو admins.\n    match /groupDirectory/{gid} {\n      allow get, list: if signedIn();\n      allow create: if signedIn() && request.auth.uid == request.resource.data.owner\n        && request.resource.data.keys().hasOnly(['kind','name','desc','photo','owner','public','verified','joinOpen','handle','createdAt','lastText','lastAt','lastUid'])\n        && request.resource.data.kind in ['group','channel']\n        && ((request.resource.data.kind == 'channel' && request.resource.data.public == true) || request.resource.data.public == false)\n        && (existsAfter(/databases/$(db)/documents/groups/$(gid))\n          ? getAfter(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid : false);\n      allow update: if signedIn() && resource.data.owner == request.auth.uid\n        && request.auth.uid == request.resource.data.owner\n        && request.resource.data.keys().hasOnly(['kind','name','desc','photo','owner','public','verified','joinOpen','handle','createdAt','lastText','lastAt','lastUid'])\n        && get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid;\n      allow delete: if signedIn() && (request.auth.uid == resource.data.owner || isOwner());\n    }\n\n    // مفتاح رابط الدعوة (الأعضاء بس يقروه، والمشرف يغيّره = إعادة تعيين الرابط)\n    match /groups/{gid}/secret/{d} {\n      function G() { return get(/databases/$(db)/documents/groups/$(gid)).data; }\n      allow read: if signedIn() && d == 'invite' && request.auth.uid in G().members;\n      allow create, update: if signedIn() && d == 'invite'\n        && request.resource.data.keys().hasOnly(['key'])\n        && request.resource.data.key is string && request.resource.data.key.size() >= 12 && request.resource.data.key.size() <= 40\n        && (gAdmin(G()) || getAfter(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid);\n    }\n    // إثبات إن العضو الجديد معاه المفتاح (بيتكتب في نفس العملية مع الانضمام)\n    match /groups/{gid}/invites/{u} {\n      allow create, update: if signedIn() && notBanned() && request.auth.uid == u\n        && request.resource.data.keys().hasOnly(['k']) && request.resource.data.k is string && request.resource.data.k.size() <= 40;\n      allow read, delete: if signedIn() && request.auth.uid == u;\n    }\n    // روابط دعوة المشرف (المالك بس بيعملها)\n    match /groups/{gid}/adminInvites/{t} {\n      function G() { return get(/databases/$(db)/documents/groups/$(gid)).data; }\n      allow create: if signedIn() && G().owner == request.auth.uid && t.matches('^[A-Za-z0-9]{16,40}$')\n        && request.resource.data.keys().hasOnly(['at']);\n      allow read: if signedIn() && G().owner == request.auth.uid;\n      allow delete: if signedIn() && (G().owner == request.auth.uid\n        || getAfter(/databases/$(db)/documents/groups/$(gid)/adminAccepts/$(request.auth.uid)).data.t == t);\n    }\n    match /groups/{gid}/adminAccepts/{u} {\n      allow create, update: if signedIn() && notBanned() && request.auth.uid == u\n        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is string && request.resource.data.t.size() <= 40;\n      allow read, delete: if signedIn() && request.auth.uid == u;\n    }\n\n    // طلبات الانضمام (للمجموعات اللي فيها \"الموافقة على الأعضاء الجدد\")\n    match /groups/{gid}/requests/{uid} {\n      function G() { return get(/databases/$(db)/documents/groups/$(gid)).data; }\n      allow create: if signedIn() && notBanned() && request.auth.uid == uid\n        && G().get('joinOpen', false) == true && G().get('approve', false) == true && !(uid in G().members) && !(uid in G().get('banned', [])) && inviteOk(gid, G())\n        && request.resource.data.keys().hasOnly(['at','name']);\n      allow read, delete: if signedIn() && (request.auth.uid == uid || gAdmin(G()));\n    }\n\n    match /groups/{gid}/messages/{m} {\n      function G() { return get(/databases/$(db)/documents/groups/$(gid)).data; }\n      allow read: if signedIn() && (request.auth.uid in G().members || (G().get('public', false) == true && G().kind == 'channel'));\n      allow create: if signedIn() && notBanned() && request.auth.uid in G().members\n        && (!(request.auth.uid in G().get('muted', {})) || G().get('muted', {})[request.auth.uid] < request.time.toMillis())\n        && ((G().kind == 'group' && G().get('sendAdmins', false) == false) || request.auth.uid == G().owner || request.auth.uid in G().admins)\n        && request.resource.data.keys().hasOnly(['uid','text','at','reply','img','loc','fwd','poll'])\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.get('text', '') is string\n        && request.resource.data.get('text', '').size() <= 2000\n        && (request.resource.data.get('text', '').size() > 0 || 'img' in request.resource.data || 'loc' in request.resource.data || 'poll' in request.resource.data)\n        && (!('poll' in request.resource.data) || (request.resource.data.poll.keys().hasOnly(['q','o'])\n              && request.resource.data.poll.q is string && request.resource.data.poll.q.size() >= 1 && request.resource.data.poll.q.size() <= 200\n              && request.resource.data.poll.o is list && request.resource.data.poll.o.size() >= 2 && request.resource.data.poll.o.size() <= 12))\n        && request.resource.data.get('img', '').size() < 400000;\n      allow update: if (signedIn() && resource.data.uid == request.auth.uid\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','text','img','loc','reply'])\n        && request.resource.data.deleted == true)\n        // تعديل منشور: صاحبه فقط، والنص لا يتجاوز 2000 حرف\n        || (signedIn() && resource.data.uid == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])\n          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)\n        // تفاعل بإيموجي: العضو يعدّل خانته هو بس جوه reactions\n        || (signedIn() && request.auth.uid in G().members && G().get('noReact', false) == false\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])\n          && request.resource.data.reactions is map\n          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))\n        // تصويت في استفتاء: العضو يعدّل صوته هو بس\n        || (signedIn() && request.auth.uid in G().members && 'poll' in resource.data\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])\n          && request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid])\n          && (!(request.auth.uid in request.resource.data.votes)\n              || (request.resource.data.votes[request.auth.uid] is int\n                  && request.resource.data.votes[request.auth.uid] >= 0\n                  && request.resource.data.votes[request.auth.uid] < resource.data.poll.o.size())));\n      allow delete: if signedIn() && (resource.data.uid == request.auth.uid\n        || (request.auth.uid in G().members && (request.auth.uid == G().owner || request.auth.uid in G().admins)));\n    }\n\n    // إيصالات القراءة: لا يكتبها إلا القارئ نفسه، ولا يقرأها إلا مرسل الرسالة أو مشرف المجموعة/القناة أو طرف الخاص\n    match /groups/{gid}/messages/{m}/receipts/{uid} {\n      function G() { return get(/databases/$(db)/documents/groups/$(gid)).data; }\n      function M() { return get(/databases/$(db)/documents/groups/$(gid)/messages/$(m)).data; }\n      allow create, update: if signedIn() && uid == request.auth.uid && uid in G().members && request.resource.data.keys().hasOnly(['uid','at']);\n      allow read: if signedIn() && (request.auth.uid == M().uid || request.auth.uid == G().owner || request.auth.uid in G().admins);\n    }\n    match /chats/{chatId}/messages/{m}/receipts/{uid} {\n      function M() { return get(/databases/$(db)/documents/chats/$(chatId)/messages/$(m)).data; }\n      allow create, update: if signedIn() && uid == request.auth.uid && (chatId == 'public' || (chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid)) && request.resource.data.keys().hasOnly(['uid','at']);\n      allow read: if signedIn() && (chatId == 'public' ? (request.auth.uid == M().uid || isOwner()) : (chatId.split('_')[0] == request.auth.uid || chatId.split('_')[1] == request.auth.uid));\n    }\n    // إحصائيات مجهّلة: كل عضو يكتب سجله فقط، والمشرفون يقرؤون التجميع\n    match /groups/{gid}/analytics/{uid} {\n      function G() { return get(/databases/$(db)/documents/groups/$(gid)).data; }\n      allow create, update: if signedIn() && uid == request.auth.uid && uid in G().members\n        && request.resource.data.keys().hasOnly(['uid','opens','lastOpen','firstOpen'])\n        && request.resource.data.uid == uid && request.resource.data.opens is int;\n      allow read, list: if signedIn() && (request.auth.uid == G().owner || request.auth.uid in G().admins);\n    }\n\n    match /handles/{h} {\n      allow get: if signedIn();\n      allow list: if isOwner();\n      allow create: if signedIn() && h.matches('^[a-z0-9_]{3,20}$')\n        && request.resource.data.keys().hasOnly(['gid','owner'])\n        && request.resource.data.owner == request.auth.uid\n        && getAfter(/databases/$(db)/documents/groups/$(request.resource.data.gid)).data.owner == request.auth.uid;\n      allow delete: if signedIn() && (resource.data.owner == request.auth.uid\n        || get(/databases/$(db)/documents/groups/$(resource.data.gid)).data.owner == request.auth.uid);\n    }\n\n    match /reports/{id} {\n      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid\n        && request.resource.data.keys().hasOnly(['reporter','kind','chatId','messageId','targetUid','text','at'])\n        && request.resource.data.text is string && request.resource.data.text.size() <= 200;\n      allow read, delete: if isOwner();\n    }\n\n    // ---------- إحصائيات الزيارات ----------\n    match /stats/{d} {\n      allow read: if isOwner();\n      allow create: if signedIn() && request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;\n      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])\n        && request.resource.data.visits == resource.data.visits + 1;\n    }\n\n    // -